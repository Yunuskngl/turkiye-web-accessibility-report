{
  "Scan": {
    "NavigationTimeoutSeconds": 30,
    "LoadWaitSeconds": 10,
    "SettleMilliseconds": 2000,
    "ResizeSettleMilliseconds": 500,
    "Locale": "tr-TR",
    "UserAgentProduct": "TurkiyeWebA11yReport/0.2",
    "MethodologyUrl": "https://github.com/Yunuskngl/turkiye-web-accessibility-report/blob/main/docs/methodology.md",
    "Desktop": { "Name": "Desktop", "Width": 1280, "Height": 800 },
    "Mobile": { "Name": "Mobile", "Width": 390, "Height": 844 },
    "AxeTags": [ "wcag2a", "wcag2aa", "wcag21a", "wcag21aa", "wcag22aa" ]
  },
  "Run": {
    "Concurrency": 3,
    "DelayBetweenSitesSeconds": 3,
    "RobotsTimeoutSeconds": 10,
    "ManifestFolder": "data/runs"
  },
  "Data": {
    "SitesFile": "data/sites.csv",
    "SitesSourceFile": "data/sites.source.json",
    "SectorsFile": "data/sectors.csv",
    "IncludeFile": "data/include-domains.csv",
    "ExcludeFile": "data/exclude-domains.csv",
    "OptOutFile": "data/opt-out.csv",
    "OtherTldCandidatesFile": "output/other-tld-candidates.csv",
    "MaxSites": 1000,
    "OtherTldCandidateMaxBucket": 5000
  },
  "Llm": {
    "Provider": "Ollama",
    "BaseUrl": "http://127.0.0.1:11434/",
    "Model": "gemma3:4b",
    "TimeoutSeconds": 300,
    "Temperature": 0.2,
    "ExplanationsFile": "data/explanations/rules.tr.json"
  },
  "Storage": {
    "DatabasePath": "output/a11yreport.db",
    "MaxNodesPerRule": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http": "Warning"
    }
  }
}
